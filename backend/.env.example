# ==============================================================================
# CMPDI / CIL Document AI - Backend Environment Template (Production)
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# Server & Host Settings (Render, Railway, Fly.io dynamically inject PORT)
HOST=0.0.0.0
PORT=8000

# Security & CORS Configuration
# Comma-separated list of allowed origins (e.g., https://your-frontend.vercel.app)
# Subdomains on *.vercel.app, *.railway.app, *.onrender.com and localhost are automatically accepted
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
FRONTEND_PUBLIC_URL=https://your-frontend.vercel.app

# JWT Authentication
# Generate a strong 64-char secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL)
# Option A (Recommended for Cloud): Provide a single unified DATABASE_URL
# Works seamlessly with Neon, Supabase, Render PostgreSQL, Railway, AWS RDS
# e.g., postgresql://neondb_owner:password@ep-cool-123.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/cmpdi_document_ai

# Option B (For local or manual component-based config):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cmpdi_document_ai

# LLM / AI Configuration
# Providers: groq (recommended / fast), gemini, openai, ollama
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here  # Optional: For deep borehole/table LlamaParse

# File & Vector Storage Persistence Paths
UPLOADS_DIR=uploads
VECTOR_STORE_DIR=vector_store

