# CMPDI / CIL Document AI Backend Environment Configuration (Production Template)

# Application & Environment Settings
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# Server & Host Settings
HOST=0.0.0.0
PORT=8000

# Security & CORS Configuration
# Comma-separated list of allowed origins (e.g., https://your-production-domain.com)
ALLOWED_ORIGINS=https://your-cmpdi-domain.com,http://localhost:3000
FRONTEND_PUBLIC_URL=https://your-cmpdi-domain.com

# JWT Authentication
# Replace with a strong, randomly generated secret key in production (e.g. openssl rand -hex 32)
JWT_SECRET=your_production_jwt_secret_key_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL)
# Either provide full DATABASE_URL or individual POSTGRES_* components
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/cmpdi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cmpdi

# LLM Provider Configuration
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here

# File & Vector Storage Persistence Paths
UPLOADS_DIR=uploads
VECTOR_STORE_DIR=vector_store
